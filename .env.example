# ┌──────────────────────────────────────────────────────────────┐
# │         Lab Management System — Environment Variables         │
# │                                                               │
# │  Copy this file to `.env` for local development:              │
# │    cp .env.example .env                                       │
# │                                                               │
# │  For production, set these as system environment variables    │
# │  or use a `.env` file in the application directory.           │
# └──────────────────────────────────────────────────────────────┘

# ── Application ──────────────────────────────────────────────────

# Runtime environment: development | staging | production
# Controls log level defaults. Set to "production" for labs.
APP_ENV=development

# Display name shown in window title / reports
APP_NAME=Lab Management System

# Override the version (defaults to Cargo.toml package.version)
# APP_VERSION=0.1.0

# ── Logging ──────────────────────────────────────────────────────

# Log level: trace | debug | info | warn | error
# Overrides the default derived from APP_ENV.
# - development defaults to "debug"
# - staging defaults to "info"
# - production defaults to "warn"
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────────

# Custom database file path (absolute or relative).
# When set, the app uses this exact file instead of the
# platform data directory (e.g. %APPDATA%\lab-management-system\lab_data.db).
# Useful for:
#   - Storing DB on a network share for shared access
#   - Keeping DB on a separate encrypted drive
#   - Running multiple instances with different databases
# DB_PATH=C:\LabData\lab_data.db

# Maximum number of backup files to retain before pruning old ones.
# Backups are stored in {data_dir}/backups/ with timestamps.
# Oldest backups are pruned first (FIFO by modification time).
MAX_BACKUPS=5