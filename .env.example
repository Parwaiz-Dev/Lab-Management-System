# ⚙️ Lab Management System - Environment Configuration
# 
# Copy this file to .env and configure for your environment
# Variables without defaults are REQUIRED for production

# ============================================================================
# 🌍 ENVIRONMENT SETTINGS
# ============================================================================

# Application environment: development, staging, production
# Default: development
APP_ENV=development

# Application name (displayed in UI)
# Default: Lab Management System
APP_NAME=Lab Management System

# Application version (should match package.json)
# Default: 1.0.0
APP_VERSION=1.0.0

# ============================================================================
# 📝 LOGGING
# ============================================================================

# Log level: trace, debug, info, warn, error
# Production recommended: warn
# Development recommended: debug
# Default: depends on APP_ENV
LOG_LEVEL=debug

# Enable debug mode (extra verbose logging)
# Default: true for development, false for production
DEBUG=true

# ============================================================================
# 📁 DATABASE SETTINGS
# ============================================================================

# Custom database path (optional)
# If not set, uses default: $HOME/.local/share/lab-management-system/lab_data.db
# Example: /opt/lab-system/data/lab_data.db
# DB_PATH=/custom/path/lab_data.db

# ============================================================================
# 🧪 APPLICATION SETTINGS
# ============================================================================

# Maximum patient search results (prevents overwhelming large result sets)
# Default: 10
# Range: 5-100
MAX_SEARCH_RESULTS=10

# Maximum backup files to retain
# Default: 5
# Older backups are deleted automatically
MAX_BACKUPS=5

# Currency symbol for display (₹, $, €, etc.)
# Default: ₹
CURRENCY_SYMBOL=₹

# ============================================================================
# 📊 ANALYTICS & MONITORING
# ============================================================================

# Enable analytics/telemetry collection
# Default: false for development, true for production
# Set to false to disable all analytics
ANALYTICS_ENABLED=false

# ============================================================================
# 🔒 SECURITY (FUTURE - not yet implemented)
# ============================================================================

# Database encryption (when implemented)
# DB_ENCRYPTION_KEY=your-256-bit-key-hex-encoded

# API rate limiting (when implemented)
# API_RATE_LIMIT=100

# Maximum request payload size
# API_MAX_PAYLOAD_SIZE=1048576

# ============================================================================
# 🚀 PRODUCTION CHECKLIST
# ============================================================================

# Before deploying to production:
# 1. ✅ Set APP_ENV=production
# 2. ✅ Set LOG_LEVEL=warn (or error)
# 3. ✅ Set DEBUG=false
# 4. ✅ Set ANALYTICS_ENABLED=true
# 5. ✅ Configure DATABASE backup strategy
# 6. ✅ Test all backup/restore functionality
# 7. ✅ Review security settings
# 8. ✅ Enable SSL/TLS if using network features
# 9. ✅ Configure monitoring and alerting
# 10. ✅ Document custom configuration
